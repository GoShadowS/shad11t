---
/**
 * Shad11t — /admin: панель управления проектами.
 * noindex, безопасный локальный вход без хранения хешей в GitHub.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import admin from '../data/admin.json';
import { pg } from '../lib/paths';

const adminConfig = { adminUser: admin.adminUser || 'shad11t' };
---

<Base
  title="Панель управления"
  description="Панель управления проектами Shad11t"
  path={pg('admin')}
  noindex
>
  <div id="admin-root" class="mx-auto max-w-[1100px] px-5 pt-[120px] pb-24 md:px-8">
    <script type="application/json" id="admin-auth-config" set:html={JSON.stringify(adminConfig)} />

    {/* ================= ВХОД / НАСТРОЙКА ================= */}
    <div id="admin-login" class="mx-auto max-w-md">
      <div class="border border-white/10 bg-abyss p-6 md:p-8">
        <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
          <span class="font-mono text-[12px] font-bold text-bone uppercase tracking-wider">ADMIN PANEL</span>
          <span class="font-mono text-[11px] text-phos">v2.0</span>
        </div>

        <h1 id="login-title" class="font-display text-2xl font-bold text-bone">Вход в панель</h1>
        <p id="login-desc" class="font-mono mt-2 text-[12px] text-sage">
          Введите учётные данные администратора
        </p>

        <form id="login-form" class="mt-6 space-y-4" autocomplete="off">
          <div>
            <label class="lbl" for="login-user">Пользователь</label>
            <input id="login-user" type="text" class="field" value="shad11t" autocomplete="username" required />
          </div>

          <div id="setup-pass-group" class="space-y-4 hidden">
            <div>
              <label class="lbl" for="setup-pass">Задайте мастер-пароль</label>
              <input id="setup-pass" type="password" class="field" placeholder="Минимум 6 символов" autocomplete="new-password" />
            </div>
            <div>
              <label class="lbl" for="setup-pass-confirm">Повторите пароль</label>
              <input id="setup-pass-confirm" type="password" class="field" placeholder="Повтор пароля" autocomplete="new-password" />
            </div>
          </div>

          <div id="regular-pass-group">
            <label class="lbl" for="login-pass">Пароль или GitHub Token</label>
            <input id="login-pass" type="password" class="field" placeholder="••••••••••" autocomplete="current-password" />
          </div>

          <p id="login-error" class="font-mono min-h-[18px] text-[12px] text-blood" role="alert"></p>

          <button type="submit" id="btn-login-submit" class="btn-void btn-solid w-full justify-center py-3 text-[12px]" data-cursor="hover">
            <Icon name="KeyRound" class="h-4 w-4" />
            <span id="btn-login-label">Войти</span>
          </button>
        </form>

        <div class="mt-6 border-t border-white/10 pt-4">
          <p class="font-mono text-[11px] leading-relaxed text-sage/70">
            Безопасность: пароль шифруется и хранится исключительно в вашем локальном браузере. В репозитории GitHub пароли не сохраняются.
          </p>
        </div>
      </div>
    </div>

    {/* ================= РАБОЧАЯ ПАНЕЛЬ ================= */}
    <div id="admin-panel" class="hidden">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-5">
        <div>
          <span class="font-mono text-[11px] text-phos tracking-wider uppercase">Управление контентом</span>
          <h1 class="font-display text-3xl font-black text-bone">Панель управления</h1>
        </div>
        <button type="button" id="btn-logout" data-cursor="hover" class="btn-void btn-ghost px-4 py-2 text-[12px]">
          <Icon name="LogOut" class="h-4 w-4" /> Выйти
        </button>
      </div>

      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Разделы админки">
        <button type="button" data-tab="projects" data-cursor="hover" class="tab-btn on" role="tab"><Icon name="LayoutGrid" class="h-4 w-4" /> Проекты</button>
        <button type="button" data-tab="editor" data-cursor="hover" class="tab-btn" role="tab"><Icon name="Pencil" class="h-4 w-4" /> Редактор</button>
        <button type="button" data-tab="order" data-cursor="hover" class="tab-btn" role="tab"><Icon name="ListOrdered" class="h-4 w-4" /> Порядок</button>
        <button type="button" data-tab="publish" data-cursor="hover" class="tab-btn" role="tab"><Icon name="Rocket" class="h-4 w-4" /> Публикация</button>
        <button type="button" data-tab="security" data-cursor="hover" class="tab-btn" role="tab"><Icon name="ShieldCheck" class="h-4 w-4" /> Безопасность</button>
      </div>

      {/* ------- проекты ------- */}
      <section data-panel="projects" class="mt-6" role="tabpanel">
        <div id="ov-summary" class="mb-4 flex flex-wrap gap-2"></div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <p class="font-mono text-[12px] text-sage">Черновики и правки сохраняются в браузере до публикации</p>
          <button type="button" id="btn-new" data-cursor="hover" class="btn-void btn-solid px-5 py-2.5 text-[12px]">
            <Icon name="Plus" class="h-4 w-4" /> Новый проект
          </button>
        </div>
        <div id="admin-list" class="space-y-3"></div>
      </section>

      {/* ------- редактор ------- */}
      <section data-panel="editor" class="mt-6 hidden" role="tabpanel">
        <h2 id="editor-title" class="font-display text-2xl font-bold text-bone">Параметры проекта</h2>
        <form id="project-form" class="border border-white/10 bg-abyss mt-4 p-5 md:p-7" autocomplete="off">
          <div class="grid gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
              <label class="lbl" for="f-title">Название проекта *</label>
              <input id="f-title" type="text" maxlength="80" class="field" placeholder="Название проекта" required />
            </div>
            <div>
              <label class="lbl" for="f-id">ID (латиница, для URL)</label>
              <input id="f-id" type="text" maxlength="60" class="field" placeholder="автоматически из названия" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="lbl" for="f-category">Категория</label>
                <select id="f-category" class="field" data-cursor="hover">
                  <option value="mod">Моды и плагины</option>
                  <option value="app">Десктопное приложение</option>
                  <option value="mobile-app">Мобильное приложение</option>
                  <option value="other">Скрипты и боты</option>
                </select>
              </div>
              <div>
                <label class="lbl" for="f-date">Дата релиза</label>
                <input id="f-date" type="date" class="field" />
              </div>
            </div>
            <div class="md:col-span-2">
              <label class="lbl" for="f-description">Описание проекта</label>
              <textarea id="f-description" rows="5" class="field resize-y" placeholder="Описание возможностей, архитектуры и технологий…"></textarea>
            </div>
            <div>
              <label class="lbl" for="f-image">Обложка (URL картинки)</label>
              <input id="f-image" type="url" class="field" placeholder="Оставьте пустым для автогенерации" />
            </div>
            <div>
              <label class="lbl" for="f-link">Ссылка на проект / GitHub</label>
              <input id="f-link" type="url" class="field" placeholder="https://github.com/GoShadowS/…" />
            </div>
            <div>
              <label class="lbl" for="f-tags">Теги (через запятую)</label>
              <input id="f-tags" type="text" class="field" placeholder="Java, Web, Python, Tauri" />
            </div>
            <div class="flex items-end pb-1">
              <label class="check-row">
                <input id="f-featured" type="checkbox" />
                <span class="check-box"><Icon name="Check" class="h-4 w-4" /></span>
                <span class="font-mono text-[13px] text-bone">В избранное (на главную)</span>
              </label>
            </div>
          </div>

          <div class="mt-5">
            <p class="lbl">Предпросмотр обложки</p>
            <div id="cover-preview-box" class="cover-preview"></div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <button type="submit" class="btn-void btn-solid px-6 py-3 text-[12px]" data-cursor="hover">
              <Icon name="Save" class="h-4 w-4" /> Сохранить проект
            </button>
            <button type="button" id="btn-cancel" class="btn-void btn-ghost px-5 py-3 text-[12px]" data-cursor="hover">
              Отмена
            </button>
          </div>
        </form>
      </section>

      {/* ------- порядок ------- */}
      <section data-panel="order" class="mt-6 hidden" role="tabpanel">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <p class="font-mono text-[12px] text-sage">Используйте стрелки для изменения порядка отображения на витрине</p>
          <button type="button" id="btn-order-reset" data-cursor="hover" class="btn-void btn-ghost px-4 py-2 text-[12px]">
            Сбросить порядок
          </button>
        </div>
        <div id="order-list" class="max-w-2xl space-y-2"></div>
      </section>

      {/* ------- публикация ------- */}
      <section data-panel="publish" class="mt-6 hidden" role="tabpanel">
        <div class="border border-white/10 bg-abyss p-5 md:p-7">
          <h2 class="font-display text-xl font-bold text-bone">Подключение к GitHub</h2>
          <p class="font-mono mt-1 text-[12px] text-sage">
            Персональный токен GitHub (PAT classic) с правами repo и gist для публикации обновлений
          </p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
              <label class="lbl" for="gh-owner">Владелец репозитория</label>
              <input id="gh-owner" type="text" class="field" value="GoShadowS" placeholder="GoShadowS" autocomplete="off" />
            </div>
            <div>
              <label class="lbl" for="gh-repo">Имя репозитория</label>
              <input id="gh-repo" type="text" class="field" value="shad11t" placeholder="shad11t" autocomplete="off" />
            </div>
            <div>
              <label class="lbl" for="gh-branch">Ветка</label>
              <input id="gh-branch" type="text" class="field" placeholder="main" autocomplete="off" />
            </div>
            <div>
              <label class="lbl" for="gh-path">Путь к файлу</label>
              <input id="gh-path" type="text" class="field" placeholder="src/data/projects.json" autocomplete="off" />
            </div>
            <div class="sm:col-span-2">
              <label class="lbl" for="gh-token">GitHub Token (PAT)</label>
              <input id="gh-token" type="password" class="field" placeholder="ghp_…" autocomplete="off" />
              <label class="check-row mt-3">
                <input id="gh-remember" type="checkbox" />
                <span class="check-box"><Icon name="Check" class="h-4 w-4" /></span>
                <span class="font-mono text-[13px] text-bone">Сохранить токен локально в этом браузере</span>
              </label>
            </div>
            <div class="sm:col-span-2">
              <label class="lbl" for="gh-message">Текст коммита</label>
              <input id="gh-message" type="text" class="field" placeholder="content: update projects showcase" autocomplete="off" />
            </div>
          </div>
        </div>

        <div class="border border-white/10 bg-abyss mt-6 p-5 md:p-7">
          <h2 class="font-display text-xl font-bold text-bone">Публикация в репозиторий</h2>
          <p class="font-mono mt-1 text-[12px] text-sage">
            Запушит projects.json прямо в main ветку репозитория. GitHub Actions автоматически пересоберёт сайт и обновит страницы.
          </p>
          <button type="button" id="btn-publish" data-cursor="hover" class="btn-void btn-solid mt-4 px-6 py-3 text-[12px] disabled:opacity-60">
            <Icon name="Rocket" class="h-4 w-4" /> Опубликовать в репозиторий
          </button>
          <div id="publish-status" class="font-mono mt-3 min-h-[20px] text-[12px]"></div>
        </div>

        <div class="border border-white/10 bg-abyss mt-6 p-5 md:p-7">
          <h2 class="font-display text-xl font-bold text-bone">Мгновенная публикация через Gist</h2>
          <p class="font-mono mt-1 text-[12px] text-sage">
            Обновляет проекты в Gist-хранилище — изменения сразу видны на сайте без пересборки.
          </p>
          <div id="gist-status" class="font-mono mt-3 min-h-[20px] text-[12px]"></div>
          <div class="mt-4 flex flex-wrap gap-3">
            <button type="button" id="btn-gist-publish" data-cursor="hover" class="btn-void btn-solid px-6 py-2.5 text-[12px] disabled:opacity-60">
              <Icon name="Zap" class="h-4 w-4" /> Опубликовать в Gist
            </button>
            <button type="button" id="btn-gist-create" data-cursor="hover" class="btn-void btn-ghost px-5 py-2.5 text-[12px] disabled:opacity-60">
              <Icon name="Plus" class="h-4 w-4" /> Создать Gist
            </button>
          </div>
        </div>

        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <div class="border border-white/10 bg-abyss p-5">
            <h3 class="font-display text-lg font-bold text-bone">Экспорт данных</h3>
            <p class="font-mono mt-1 text-[12px] text-sage">Скачать или скопировать JSON файл проектов</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <button type="button" id="btn-download" data-cursor="hover" class="btn-void btn-ghost px-4 py-2.5 text-[12px]">
                <Icon name="Download" class="h-4 w-4" /> Скачать JSON
              </button>
              <button type="button" id="btn-copy-json" data-cursor="hover" class="btn-void btn-ghost px-4 py-2.5 text-[12px]">
                <Icon name="Copy" class="h-4 w-4" /> Копировать
              </button>
            </div>
          </div>
          <div class="border border-white/10 bg-abyss p-5">
            <h3 class="font-display text-lg font-bold text-bone">Импорт данных</h3>
            <p class="font-mono mt-1 text-[12px] text-sage">Загрузить JSON проектов</p>
            <textarea id="import-text" rows="2" class="field mt-3" placeholder='[{"id": "...", ...}]'></textarea>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <label class="btn-void btn-ghost cursor-pointer px-4 py-2 text-[12px]" data-cursor="hover">
                <Icon name="Upload" class="h-4 w-4" /> Выбрать файл
                <input id="file-import" type="file" accept="application/json,.json" class="hidden" />
              </label>
              <button type="button" id="btn-import" data-cursor="hover" class="btn-void btn-solid px-4 py-2 text-[12px]">
                Импортировать
              </button>
            </div>
          </div>
        </div>

        <div class="mt-6 border border-blood/30 bg-blood/5 p-5">
          <h3 class="font-display text-lg font-bold text-blood">Сброс локальных правок</h3>
          <p class="font-mono mt-1 text-[12px] text-sage">Удалить черновики из браузера и вернуться к данным репозитория</p>
          <button type="button" id="btn-overlay-reset" data-cursor="hover" class="btn-void btn-danger mt-3 px-5 py-2.5 text-[12px]">
            <Icon name="Trash2" class="h-4 w-4" /> Сбросить локальные правки
          </button>
        </div>
      </section>

      {/* ------- безопасность ------- */}
      <section data-panel="security" class="mt-6 hidden" role="tabpanel">
        <div class="border border-white/10 bg-abyss max-w-2xl p-5 md:p-7">
          <h2 class="font-display text-xl font-bold text-bone">Смена мастер-пароля</h2>
          <p class="font-mono mt-1 text-[12px] text-sage">
            Пароль сохраняется локально в зашифрованном виде в вашем браузере
          </p>
          <form id="pass-form" class="mt-5 space-y-4" autocomplete="off">
            <div>
              <label class="lbl" for="pw-current">Текущий пароль</label>
              <input id="pw-current" type="password" class="field" autocomplete="current-password" required />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="lbl" for="pw-new">Новый пароль (мин. 6)</label>
                <input id="pw-new" type="password" class="field" autocomplete="new-password" required minlength="6" />
              </div>
              <div>
                <label class="lbl" for="pw-confirm">Подтверждение</label>
                <input id="pw-confirm" type="password" class="field" autocomplete="new-password" required minlength="6" />
              </div>
            </div>
            <button type="submit" class="btn-void btn-solid px-6 py-2.5 text-[12px]" data-cursor="hover">
              <Icon name="ShieldCheck" class="h-4 w-4" /> Обновить пароль
            </button>
          </form>
        </div>
      </section>
    </div>
  </div>
</Base>
