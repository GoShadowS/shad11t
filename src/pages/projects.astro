---
/**
 * Shad11t — /projects: витрина с фильтрами, поиском и сортировкой.
 * Сетка рендерится клиентом из объединённых данных (base + оверлей админки).
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import projectsData from '../data/projects.json';
import { pg } from '../lib/paths';
import { CATEGORIES } from '../lib/format';

const projects = projectsData.filter((p) => p && (p as { id?: string }).id);
const counts: Record<string, number> = { all: projects.length };
for (const p of projects) {
  const c = (p as { category?: string }).category || 'other';
  counts[c] = (counts[c] || 0) + 1;
}
const filters = [
  { id: 'all', label: 'Всё' },
  ...Object.entries(CATEGORIES).map(([id, c]) => ({ id, label: c.label })),
];
---

<Base
  title="Проекты"
  description="Витрина проектов Shad11t: веб-сервисы, мобильные и десктопные приложения, боты, моды и скрипты."
  path={pg('projects')}
>
  <section class="relative overflow-hidden pt-[130px] pb-10" data-parallax-wrap>
    <div class="bg-blueprint-fade pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute top-16 -right-16 hidden select-none lg:block" aria-hidden="true">
      <span data-parallax="0.2" class="font-display text-ghost block text-[13rem] leading-none font-black">▦</span>
    </div>

    <div class="relative mx-auto max-w-[1400px] px-5 md:px-8">
      <p data-reveal="up" data-i18n="projects.tag" class="font-mono mb-5 text-[12px] tracking-[0.3em] text-ember uppercase">// витрина // {projects.length} проектов</p>
      <h1 data-reveal="chars" class="font-display max-w-4xl text-4xl sm:text-5xl md:text-6xl font-black text-bone">
        <span data-i18n="projects.title">Витрина проектов</span><span class="text-phos">.</span>
      </h1>
      <p data-reveal="up" data-i18n="projects.sub" class="mt-5 max-w-xl text-[15px] leading-relaxed text-sage">
        Моды, десктопные и мобильные приложения, боты, плагины и скрипты. Выбирай фильтр или ищи по стеку.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 pb-28 md:px-8" data-projects-app>
    {/* панель управления */}
    <div data-reveal="up" class="term-window scanlines mb-10 p-4 md:p-5">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Фильтр по категориям">
          {filters.map((f) => (
            <button
              type="button"
              data-filter={f.id}
              data-cursor="hover"
              class:list={['tab-btn clip-corners-sm !normal-case !tracking-normal', f.id === 'all' && 'on']}
            >
              {f.label}
              <span class="opacity-60">({counts[f.id] || 0})</span>
            </button>
          ))}
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:ml-auto">
          <label class="relative block sm:w-56">
            <span class="sr-only">Поиск по проектам</span>
            <Icon name="Search" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-sage" />
            <input
              type="search"
              data-projects-search
              data-i18n-ph="projects.searchPh"
              placeholder="Поиск по названию или тегу…"
              class="field !pl-9"
              autocomplete="off"
            />
          </label>
          <label class="block sm:w-48">
            <span class="sr-only">Сортировка</span>
            <select data-projects-sort class="field" data-cursor="hover">
              <option value="featured">Сначала топ</option>
              <option value="new">Сначала новые</option>
              <option value="old">Сначала старые</option>
              <option value="az">По алфавиту</option>
            </select>
          </label>
        </div>
      </div>
      <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-3">
        <p data-projects-count class="font-mono text-[12px] text-sage">загрузка…</p>
        <p class="font-mono hidden text-[11px] text-sage/50 sm:block">клик по карточке — открыть кейс</p>
      </div>
    </div>

    <noscript>
      <div class="border border-gold/40 bg-gold/5 p-6 text-center font-mono text-[13px] text-gold">
        Включите JavaScript для просмотра каталога проектов с фильтрацией.
      </div>
      <style>
        [data-projects-grid] { display: none; }
      </style>
    </noscript>

    {/* сетка (рендерит клиент) */}
    <div data-projects-grid class="grid items-start gap-6 md:grid-cols-2">
      {/* скелетоны до загрузки */}
      {Array.from({ length: 4 }).map(() => (
        <div class="animate-pulse border border-white/10 bg-abyss" aria-hidden="true">
          <div class="aspect-[16/10] bg-white/5"></div>
          <div class="space-y-3 p-6">
            <div class="h-4 w-24 bg-white/10"></div>
            <div class="h-6 w-3/4 bg-white/10"></div>
            <div class="h-4 w-full bg-white/5"></div>
          </div>
        </div>
      ))}
    </div>

    {/* пустое состояние */}
    <div data-projects-empty class="hidden border border-dashed border-white/20 p-12 text-center">
      <p class="font-display text-3xl font-black text-bone">Ничего не найдено</p>
      <p class="font-mono mt-3 text-[13px] text-sage">попробуйте изменить запрос или сбросить категорию</p>
      <button type="button" data-filter="all" data-cursor="hover" class="btn-void btn-ghost clip-corners-sm mt-6 px-6 py-3 text-[12px]">
        Показать всё
      </button>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-6 border border-white/10 bg-abyss p-6 md:flex-row md:items-center md:p-8">
      <div>
        <p class="font-display text-2xl font-black text-bone">Интересует разработка или проект?</p>
        <p class="mt-1 text-[14px] text-sage">Приложения, сервисы, плагины — напиши в контакты.</p>
      </div>
      <a href={pg('contact')} class="btn-void btn-solid magnetic clip-corners-sm px-6 py-3.5 text-[12px]" data-cursor="hover">
        Связаться <Icon name="ArrowRight" class="h-4 w-4" />
      </a>
    </div>
  </section>
</Base>
