---
/**
 * Shad11t — /about: досье, орбита интересов, стек.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import skills from '../data/skills.json';
import videosData from '../data/videos.json';

const videosCount = videosData.filter((v) => v && (v as { id?: string }).id).length;
import { pg } from '../lib/paths';

const facts = [
  { icon: 'Fish', title: 'Вид', text: 'аксолотль', i18nTitle: 'about.facts.species', i18nText: 'about.facts.speciesVal' },
  { icon: 'Gamepad2', title: 'Класс', text: 'fullstack lotl', i18nTitle: 'about.facts.class', i18nText: 'about.facts.classVal' },
  { icon: 'Braces', title: 'Стек', text: 'Java · Web · Python · Apps', i18nTitle: 'about.facts.stack', i18nText: 'about.facts.stackVal' },
  { icon: 'brand:youtube', title: 'Канал', text: `${videosCount} видео`, i18nTitle: 'about.facts.channel', i18nText: 'about.facts.channelVal' },
];
---

<Base
  title="Обо мне"
  description="Shad11t — программист и создатель контента. Досье, интересы и стек технологий."
  path={pg('about')}
>
  {/* ================= HERO ДОСЬЕ ================= */}
  <section class="relative overflow-hidden pt-[130px] pb-16 md:pb-24" data-parallax-wrap>
    <div class="bg-blueprint-fade pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute top-10 -right-24 hidden select-none lg:block" aria-hidden="true">
      <span data-parallax="0.2" class="font-display text-ghost block text-[16rem] leading-none font-black">?</span>
    </div>

    <div class="relative mx-auto max-w-[1400px] px-5 md:px-8">
      <p data-reveal="up" data-i18n="about.dossierTag" class="font-mono mb-5 text-[12px] tracking-[0.3em] text-ember uppercase">// досье // уровень доступа: все</p>
      <h1 data-reveal="chars" class="font-display max-w-5xl text-4xl sm:text-5xl md:text-6xl font-black text-bone">
        <span data-i18n="about.title">Привет. Я — аксолотль, который пишет код.</span>
      </h1>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1.15fr_1fr] items-start">
        {/* карточка игрока */}
        <div data-reveal="left" class="term-window scanlines clip-corners relative overflow-hidden p-6 md:p-8" data-tilt>
          <div class="mb-6 flex items-center justify-between">
            <span class="font-mono text-[11px] tracking-[0.25em] text-sage uppercase">player_card.v2</span>
            <span class="chip">lvl 11</span>
          </div>
          <div class="flex items-center gap-5">
            <div class="pixel-frame float-slow shrink-0 bg-panel p-1 flex items-center justify-center h-20 w-20 md:h-24 md:w-24 overflow-hidden rounded">
              <img
                src={site.avatar || '/avatar.png'}
                alt="Аватар Shad11t"
                class="h-full w-full object-cover"
                loading="eager"
                onerror="this.onerror=null;this.src='/favicon.svg';"
              />
            </div>
            <div>
              <p class="font-display text-2xl font-black text-bone md:text-3xl">Shad11t<span class="text-phos">_</span></p>
              <p class="mt-2 inline-flex items-center gap-2 border border-phos/30 bg-phos/5 px-3 py-1 font-mono text-[11px] tracking-[0.2em] text-phos uppercase">
                <span class="pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-phos"></span> {site.status}
              </p>
            </div>
          </div>
          <p data-i18n="about.bio" class="mt-6 max-w-xl text-[15px] leading-relaxed text-sage">
            Меня зовут Shad11t. Разрабатываю софт в самых разных направлениях — от приложений, ботов и веб-сервисов до модов и инструментов, и снимаю процесс на YouTube. Этот сайт — мой аквариум: проекты, стек, видео и контакты.
          </p>
        </div>

        {/* факты: 2x2 симметричная сетка */}
        <div class="grid grid-cols-2 gap-px border border-white/15 bg-white/10 self-start w-full">
          {facts.map((f, i) => (
            <div data-reveal="up" data-delay={(i * 0.06).toFixed(2)} class="group bg-abyss p-5 transition-colors hover:bg-panel">
              <Icon name={f.icon} class="h-6 w-6 text-phos transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110" />
              <p data-i18n={f.i18nTitle} class="font-mono mt-3 text-[10px] tracking-[0.22em] text-sage uppercase">{f.title}</p>
              <p data-i18n={f.i18nText} class="mt-1 text-[14px] font-bold text-bone">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ================= ОРБИТА ИНТЕРЕСОВ ================= */}
  <section class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
    <p data-reveal="up" data-i18n="about.orbitTag" class="font-mono mb-5 text-[12px] tracking-[0.3em] text-ember uppercase">// карта интересов</p>
    <h2 data-reveal="chars" data-i18n="about.orbitTitle" class="font-display max-w-3xl text-4xl leading-[1.05] font-black text-bone md:text-5xl">
      Орбита интересов
    </h2>
    <p data-reveal="up" data-i18n="about.orbitSub" class="mt-4 max-w-xl text-[15px] text-sage">
      Интерактивная карта направлений и навыков. Нажмите на любой узел для подробной информации.
    </p>

    <div class="mt-10 grid items-start gap-6 lg:grid-cols-[1.5fr_1fr]">
      <div data-reveal="scale" data-orbit class="term-window scanlines relative overflow-hidden">
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-3">
          <span class="font-mono text-[11px] tracking-[0.25em] text-sage uppercase">shad11t.system — interests.exe</span>
          <span class="font-mono hidden text-[11px] text-sage/60 sm:block">{skills.length} узлов на орбите</span>
        </div>
        <div class="relative">
          <canvas id="orbit-canvas" class="block w-full" role="img" aria-label="Интерактивная карта интересов"></canvas>
          <div id="orbit-tip"></div>
        </div>
        <script type="application/json" id="skills-data" set:html={JSON.stringify(skills)} />
      </div>

      <div class="flex flex-col gap-6">
        <div data-reveal="right" id="skill-detail" class="term-window min-h-[190px] p-5 md:p-6" aria-live="polite"></div>
        <div data-reveal="right" data-delay="0.1" class="border border-white/10 bg-abyss p-5 md:p-6">
          <p class="lbl">Легенда орбит</p>
          <ul class="font-mono space-y-2 text-[12px]">
            <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full" style="background:#c6ff3d"></span> языки программирования</li>
            <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full" style="background:#4ade80"></span> моддинг и плагины</li>
            <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full" style="background:#ff5a1f"></span> приложения и веб</li>
            <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full" style="background:#ece9df"></span> инструменты</li>
            <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 rounded-full" style="background:#ffc53d"></span> медиа и контент</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ================= НАВЫКИ ================= */}
  <section class="border-t border-white/10 bg-abyss">
    <div class="mx-auto max-w-[1400px] px-5 py-20 md:px-8 md:py-28">
      <p data-reveal="up" data-i18n="about.stackTag" class="font-mono mb-5 text-[12px] tracking-[0.3em] text-ember uppercase">// стек</p>
      <h2 data-reveal="chars" data-i18n="about.stackTitle" class="font-display max-w-3xl text-4xl leading-[1.05] font-black text-bone md:text-5xl">
        Чем я занимаюсь
      </h2>
      <div class="mt-10 flex flex-wrap gap-3">
        {skills.map((s, i) => (
          <div data-reveal="up" data-delay={((i % 6) * 0.05).toFixed(2)} class="group border border-white/10 bg-void/60 px-5 py-4 transition-colors hover:border-phos/40">
            <p class="text-[15px] font-bold text-bone group-hover:text-phos">{s.name}</p>
            <p class="mt-1 text-[13px] text-sage">{s.desc}</p>
          </div>
        ))}
      </div>

      <div data-reveal="up" class="mt-14 flex flex-col items-start justify-between gap-6 border border-phos/25 bg-phos/[0.04] p-6 md:flex-row md:items-center md:p-8">
        <div>
          <p class="font-display text-2xl font-black text-bone md:text-3xl">Смотри проекты и разработку на канале</p>
          <p class="mt-2 max-w-xl text-[14px] text-sage">Разбор приложений, модов и архитектуры софта в видеоформате.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={site.socials.youtube} target="_blank" rel="noopener" class="btn-void btn-solid magnetic clip-corners-sm px-6 py-3.5 text-[12px]" data-cursor="hover">
            <Icon name="brand:youtube" class="h-4 w-4" /> На канал
          </a>
          <a href={pg('projects')} class="btn-void btn-ghost magnetic clip-corners-sm px-6 py-3.5 text-[12px]" data-cursor="hover">
            К проектам
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
