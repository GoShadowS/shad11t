---
/**
 * SHADVOID — 404 в духе Minecraft: чанк не загружен.
 * Плюс умный редирект /projects/<id>/ → /project/?id=<id> для локальных черновиков.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { pg } from '../lib/paths';
---

<Base
  title="Чанк не загружен"
  description="Ошибка 404: эта страница утонула в темноте."
  path={pg('404')}
  noindex
>
  <script is:inline>
    // Черновики из админки живут только в localStorage: /projects/<id>/ для них
    // физически не существует → мягко ведём на клиентский рендер /project/?id=
    try {
      var p = location.pathname.replace(/\/+$/, '');
      var m = p.match(/\/projects\/([^\/]+)$/);
      if (m) {
        var base = p.slice(0, p.length - m[0].length) + '/';
        location.replace(base + 'project/?id=' + encodeURIComponent(m[1]));
      }
    } catch (e) { /* тень молчит */ }
  </script>

  <section class="bg-dirt relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-5 pt-[72px] text-center">
    <div class="bg-blueprint pointer-events-none absolute inset-0 opacity-40"></div>

    <div class="relative">
      <p data-reveal="up" class="font-mono text-[12px] tracking-[0.35em] text-ember uppercase">// connection lost // chunk error</p>
      <h1 data-reveal="chars" class="font-display mt-4 text-[26vw] leading-none font-black text-bone drop-shadow-[0_0_60px_rgba(198,255,61,0.25)] md:text-[11rem]">
        4<span class="text-phos">0</span>4
      </h1>
      <p data-reveal="up" class="font-display mt-2 text-xl font-bold text-bone md:text-2xl">
        ЧАНК НЕ ЗАГРУЖЕН<span class="text-phos">_</span>
      </p>
      <p data-reveal="up" class="font-mono mx-auto mt-4 max-w-md text-[13px] leading-relaxed text-sage">
        Ты копнул слишком глубоко и выпал из мира.<br />Криперы уже выехали. Лучше респавнись.
      </p>

      <div data-reveal="up" class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={pg('')} class="btn-void btn-solid magnetic clip-corners px-7 py-4 text-[13px]" data-cursor="hover">
          <Icon name="Home" class="h-4 w-4" /> Респавн на главной
        </a>
        <a href={pg('projects')} class="btn-void btn-ghost magnetic clip-corners px-7 py-4 text-[13px]" data-cursor="hover">
          К проектам
        </a>
      </div>

      <div data-reveal="up" class="mc-toast mx-auto mt-10 flex max-w-md items-center gap-4 p-4 text-left">
        <svg viewBox="0 0 8 8" class="h-12 w-12 shrink-0" shape-rendering="crispEdges" aria-hidden="true" style="image-rendering:pixelated">
          <rect width="8" height="8" fill="#55a630" />
          <rect x="1" y="2" width="2" height="2" fill="#0d120b" /><rect x="5" y="2" width="2" height="2" fill="#0d120b" />
          <rect x="3" y="4" width="2" height="3" fill="#0d120b" /><rect x="2" y="5" width="1" height="2" fill="#0d120b" /><rect x="5" y="5" width="1" height="2" fill="#0d120b" />
        </svg>
        <div>
          <p class="font-mono text-[12px] font-bold text-[#ffff54]">Достижение провалено!</p>
          <p class="font-mono text-[13px] text-white">Турист темноты: страница не найдена</p>
        </div>
      </div>
    </div>
  </section>
</Base>
