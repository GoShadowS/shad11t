---
/**
 * Shad11t — 404: чанк не загружен.
 * Плюс редирект /projects/<id>/ → /project/?id=<id> для локальных черновиков.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { pg } from '../lib/paths';
---

<Base
  title="Страница не найдена"
  description="Ошибка 404: страница не найдена."
  path={pg('404')}
  noindex
>
  <script is:inline>
    // Черновики из админки живут только в localStorage: /projects/<id>/ для них
    // физически не существует → мягко ведём на клиентский рендер /project/?id=
    try {
      var p = location.pathname.replace(/\/+$/, '');
      var m = p.match(/\/projects\/([^\/]+)$/);
      if (m) {
        var base = p.slice(0, p.length - m[0].length) + '/';
        var raw = m[1];
        try { raw = decodeURIComponent(raw); } catch (e2) { /* оставляем как есть */ }
        location.replace(base + 'project/?id=' + encodeURIComponent(raw));
      }
    } catch (e) { /* молчим */ }
  </script>

  <section class="bg-dirt relative flex min-h-svh flex-col items-center justify-center overflow-hidden px-5 pt-[72px] text-center">
    <div class="bg-blueprint pointer-events-none absolute inset-0 opacity-40"></div>

    <div class="relative">
      <p data-reveal="up" data-i18n="p404.tag" class="font-mono text-[12px] tracking-[0.35em] text-ember uppercase">// 404 // ошибка адреса</p>
      <h1 data-reveal="chars" class="font-display mt-4 text-[26vw] leading-none font-black text-bone drop-shadow-[0_0_60px_rgba(198,255,61,0.25)] md:text-[11rem]">
        4<span class="text-phos">0</span>4
      </h1>
      <p data-reveal="up" class="font-display mt-2 text-xl font-bold text-bone md:text-2xl">
        <span data-i18n="p404.title">СТРАНИЦА НЕ НАЙДЕНА</span><span class="text-phos">_</span>
      </p>
      <p data-reveal="up" data-i18n="p404.desc" class="font-mono mx-auto mt-4 max-w-md text-[13px] leading-relaxed text-sage">
        Такой страницы не существует или она была перемещена по новому адресу.
      </p>

      <div data-reveal="up" class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={pg('')} class="btn-void btn-solid magnetic clip-corners px-7 py-4 text-[13px]" data-cursor="hover">
          <Icon name="Home" class="h-4 w-4" /> <span data-i18n="p404.homeBtn">На главную</span>
        </a>
        <a href={pg('projects')} class="btn-void btn-ghost magnetic clip-corners px-7 py-4 text-[13px]" data-cursor="hover">
          <span data-i18n="nav.projects">Проекты</span>
        </a>
      </div>
    </div>
  </section>
</Base>
