---
/**
 * Shad11t — /contact: порталы связи, интерактивная гостевая книга / отзывы, форма Яндекс, FAQ.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { pg } from '../lib/paths';

const socials = [
  {
    name: 'YouTube',
    handle: '@shad11t_the_shadow',
    desc: 'Видео и закулисье проектов. Главный портал.',
    href: site.socials.youtube,
    icon: 'brand:youtube',
    copy: 'https://www.youtube.com/@shad11t_the_shadow',
    accent: true,
  },
  {
    name: 'Telegram',
    handle: 't.me/SHAD11T',
    desc: 'Новости, анонсы и самый быстрый способ до меня докричаться.',
    href: site.socials.telegram,
    icon: 'brand:telegram',
    copy: 'https://t.me/SHAD11T',
    accent: true,
  },
  {
    name: 'Boosty',
    handle: 'shad11ttheshadow',
    desc: 'Эксклюзивы, ранний доступ и поддержка аксолотля рублём.',
    href: site.socials.boosty,
    icon: 'brand:boosty',
    copy: 'https://boosty.to/shad11ttheshadow',
    accent: false,
  },
  {
    name: 'GitHub',
    handle: 'GoShadowS',
    desc: 'Исходники модов, приложений и скриптов. Звёзды приветствуются.',
    href: site.socials.github,
    icon: 'brand:github',
    copy: 'https://github.com/GoShadowS',
    accent: false,
  },
];

const faqs = [
  {
    q: 'Где быстрее всего ответят?',
    a: 'В Telegram — обычно в течение дня. На YouTube-комментарии — под свежими видео. Аксолотль внимательно читает все сообщения.',
  },
  {
    q: 'Берёшь ли заказы на плагины или моды?',
    a: 'Зависит от загрузки. Напиши в гостевую книгу, через форму или в Telegram с кратким ТЗ и сроками — отвечу, смогу ли взять.',
  },
  {
    q: 'Где исходники твоих проектов?',
    a: 'Большинство выложено в открытый доступ на моём GitHub. Ссылки на репозитории есть в карточках раздела /projects.',
  },
  {
    q: 'Как предложить идею для видео или мода?',
    a: 'Оставь отзыв в гостевой книге ниже или заполни Яндекс Форму — крутые идеи часто становятся темами новых роликов.',
  },
];
---

<Base
  title="Контакты"
  description="Как связаться с Shad11t: YouTube, Telegram, Boosty, GitHub. Гостевая книга и отзывы."
  path={pg('contact')}
>
  {/* ================= HERO ================= */}
  <section class="relative overflow-hidden pt-[130px] pb-16 md:pb-24">
    <div class="bg-blueprint-fade pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-[1400px] px-5 md:px-8">
      <p data-reveal="up" class="font-mono mb-5 text-[12px] tracking-[0.3em] text-ember uppercase">// порталы связи</p>
      <h1 data-reveal="chars" class="font-display max-w-4xl text-5xl leading-[1.02] font-black text-bone md:text-7xl">
        Выходи на связь<span class="text-phos">_</span>
      </h1>
      <p data-reveal="up" class="mt-6 max-w-2xl text-[16px] leading-relaxed text-sage md:text-lg">
        Четыре официальных портала, гостевая книга с отзывами и форма обратной связи. Выбирай удобный канал.
      </p>
    </div>
  </section>

  {/* ================= КАРТОЧКИ ПОРТАЛОВ ================= */}
  <section class="mx-auto max-w-[1400px] px-5 pb-20 md:px-8 md:pb-28">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {socials.map((s, i) => (
        <div
          data-reveal="up"
          data-delay={(i * 0.08).toFixed(2)}
          class:list={[
            'p-card clip-corners relative flex flex-col justify-between p-6 transition-all duration-300 md:p-7',
            s.accent ? 'border-phos/40 bg-phos/[0.04]' : 'border-white/10 bg-abyss hover:border-phos/40',
          ]}
        >
          <div class="p-glow"></div>
          <div>
            <div class="flex items-start justify-between">
              <span class:list={[
                'clip-corners-sm flex h-14 w-14 items-center justify-center transition-all duration-300 group-hover:scale-110',
                s.accent ? 'bg-phos text-void' : 'bg-white/10 text-phos group-hover:bg-phos group-hover:text-void',
              ]}>
                <Icon name={s.icon} class="h-7 w-7" />
              </span>
              <span class="font-display text-ghost text-4xl font-black">0{i + 1}</span>
            </div>
            <h2 class="font-display mt-5 text-xl font-bold text-bone">{s.name}</h2>
            <p class="font-mono mt-1 text-[12px] text-phos">{s.handle}</p>
            <p class="mt-3 text-[13px] leading-relaxed text-sage">{s.desc}</p>
          </div>
          <div class="mt-6 flex gap-2">
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              data-cursor="hover"
              class="btn-void btn-solid flex-1 justify-center py-2.5 text-[11px]"
              aria-label={`Открыть ${s.name} Shad11t`}
            >
              Открыть ↗
            </a>
            <button
              type="button"
              data-copy={s.copy}
              data-cursor="hover"
              class="btn-void btn-ghost px-3.5 py-2.5 text-[11px]"
              aria-label={`Скопировать ссылку на ${s.name}`}
              title="Скопировать ссылку"
            >
              <Icon name="Copy" class="h-4 w-4" />
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ================= ГОСТЕВАЯ КНИГА И ОТЗЫВЫ ================= */}
  <section class="border-y border-white/10 bg-abyss py-20 md:py-28">
    <div class="mx-auto max-w-[1400px] px-5 md:px-8">
      <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
          <p data-reveal="up" class="font-mono mb-4 text-[12px] tracking-[0.3em] text-ember uppercase">// сообщество // аквариум</p>
          <h2 data-reveal="chars" class="font-display text-4xl leading-[1.05] font-black text-bone md:text-5xl">
            Книга отзывов и приветствий
          </h2>
          <p data-reveal="up" class="mt-3 max-w-xl text-[15px] text-sage">
            Оставь отзыв о проектах, пожелание или идею. Запись мгновенно сохранится в локальной книге аквариума!
          </p>
        </div>
        <div data-reveal="up" class="flex flex-wrap items-center gap-3">
          <a
            href="https://forms.yandex.ru"
            target="_blank"
            rel="noopener"
            id="btn-yandex-form"
            data-cursor="hover"
            class="btn-void btn-ghost clip-corners-sm px-5 py-3 text-[12px]"
          >
            <Icon name="Send" class="h-4 w-4 text-phos" />
            Яндекс Форма ↗
          </a>
        </div>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_1.3fr]">
        {/* Форма добавления отзыва */}
        <form id="review-form" class="term-window scanlines clip-corners p-6 md:p-8" autocomplete="off">
          <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
            <span class="font-mono text-[11px] tracking-[0.2em] text-sage uppercase">new_entry.exe</span>
            <span class="font-mono text-[11px] text-phos">● запись в реальном времени</span>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="lbl" for="rf-name">Твой позывной / Имя</label>
              <input id="rf-name" type="text" maxlength="32" class="field" placeholder="Например: AxolotlMaster" required />
            </div>
            <div>
              <label class="lbl" for="rf-role">Кто ты?</label>
              <select id="rf-role" class="field" data-cursor="hover">
                <option value="Зритель">Зритель канала</option>
                <option value="Разработчик">Разработчик / Кодер</option>
                <option value="Геймер">Геймер / Крафтер</option>
                <option value="Коллаборатор">Партнёр / Коллаборация</option>
                <option value="Гость">Гость аквариума</option>
              </select>
            </div>
          </div>

          <div class="mt-5">
            <label class="lbl">Оценка / Настроение</label>
            <div class="flex items-center gap-2" id="rf-rating-group">
              {[1, 2, 3, 4, 5].map((star) => (
                <button
                  type="button"
                  data-star={star}
                  class:list={[
                    'star-btn flex h-10 w-10 items-center justify-center border border-white/15 bg-void/60 text-lg transition-all',
                    star <= 5 ? 'border-phos/40 text-phos' : 'text-sage/40',
                  ]}
                  title={`${star} из 5`}
                  data-cursor="hover"
                >
                  🫧
                </button>
              ))}
              <span id="rf-rating-label" class="font-mono ml-2 text-[12px] text-phos font-bold">5 / 5 (максимум)</span>
            </div>
          </div>

          <div class="mt-5">
            <div class="flex items-center justify-between">
              <label class="lbl" for="rf-message">Твой отзыв или сообщение</label>
              <span id="rf-counter" class="font-mono mb-[0.45rem] text-[11px] text-sage/60">0 / 400</span>
            </div>
            <textarea
              id="rf-message"
              rows="4"
              maxlength="400"
              class="field resize-y"
              placeholder="Крутые моды и приложения! Жду новые девлоги..."
              required
            ></textarea>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
            <button type="submit" id="rf-submit" data-cursor="hover" class="btn-void btn-solid clip-corners-sm flex-1 py-3.5 text-[12px]">
              <Icon name="Send" class="h-4 w-4" />
              <span>Оставить отзыв в аквариуме</span>
            </button>
            <button type="button" id="rf-reset-demo" data-cursor="hover" class="btn-void btn-ghost clip-corners-sm px-4 py-3.5 text-[11px]" title="Сбросить к исходным записям">
              <Icon name="RotateCcw" class="h-3.5 w-3.5" />
            </button>
          </div>
          <p class="font-mono mt-3 text-center text-[10px] text-sage/60">записи сохраняются локально в твоём браузере</p>
        </form>

        {/* Список отзывов */}
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="font-mono text-[12px] tracking-[0.2em] text-sage uppercase">Лента гостевой книги</span>
            <span id="reviews-count" class="font-mono text-[12px] text-phos font-bold">Загрузка...</span>
          </div>

          <div id="reviews-list" class="space-y-3.5 max-h-[580px] overflow-y-auto pr-1">
            {/* Рендерится через contact.js */}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ================= FAQ ================= */}
  <section class="mx-auto max-w-[900px] px-5 py-20 md:px-8 md:py-28">
    <p data-reveal="up" class="font-mono mb-5 text-center text-[12px] tracking-[0.3em] text-ember uppercase">// частые вопросы</p>
    <h2 data-reveal="chars" class="font-display text-center text-4xl font-black text-bone md:text-5xl">
      Отвечаю
    </h2>
    <div class="mt-10 space-y-3">
      {faqs.map((f, i) => (
        <details data-reveal="up" data-delay={(i * 0.05).toFixed(2)} class="group border border-white/10 bg-abyss transition-colors open:border-phos/40">
          <summary data-cursor="hover" class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 md:p-6 [&::-webkit-details-marker]:hidden">
            <span class="font-display text-[16px] font-bold text-bone md:text-lg">{f.q}</span>
            <span class="font-mono flex h-8 w-8 shrink-0 items-center justify-center border border-white/15 text-phos transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <p class="px-5 pb-6 text-[14px] leading-relaxed text-sage md:px-6">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
