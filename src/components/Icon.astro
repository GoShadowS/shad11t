---
/**
 * SHADVOID — иконка (серверный SVG, ноль JS).
 * name: имя Lucide ("Terminal") или бренд ("brand:youtube").
 */
import { icon } from '../lib/icons';

interface Props {
  name: string;
  class?: string;
}

const { name, class: cls = 'w-5 h-5' } = Astro.props;
---
<Fragment set:html={icon(name, cls)} />
