---
/**
 * Shad11t — фирменный знак «аксолотль» (оригинальный пиксель-арт)
 * + словесный знак. Клик ×5 по логотипу — сюрприз :)
 */
import site from '../data/site.json';
import { pg } from '../lib/paths';

interface Props {
  compact?: boolean;
  link?: boolean;
}

const { compact = false, link = true } = Astro.props;
const faceCls = compact ? 'h-8 w-8' : 'h-9 w-9';
---

{link ? (
  <a
    href={pg('')}
    id="site-logo"
    class="group flex items-center gap-3"
    aria-label={`${site.name} — на главную`}
    data-cursor="hover"
  >
    <span class="transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105">
      <svg viewBox="0 0 8 6" class={faceCls} role="img" aria-label="Аксолотль Shad11t" shape-rendering="crispEdges">
        <rect x="1" y="0" width="1" height="1" fill="#ff8fb3" /><rect x="6" y="0" width="1" height="1" fill="#ff8fb3" />
        <rect x="0" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="2" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="5" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="7" y="1" width="1" height="1" fill="#ff8fb3" />
        <rect x="1" y="2" width="6" height="1" fill="#f2a9c4" />
        <rect x="1" y="3" width="1" height="1" fill="#f2a9c4" /><rect x="2" y="3" width="1" height="1" fill="#14100e" /><rect x="3" y="3" width="2" height="1" fill="#f2a9c4" /><rect x="5" y="3" width="1" height="1" fill="#14100e" /><rect x="6" y="3" width="1" height="1" fill="#f2a9c4" />
        <rect x="1" y="4" width="6" height="1" fill="#f2a9c4" />
        <rect x="2" y="5" width="1" height="1" fill="#f2a9c4" /><rect x="3" y="5" width="2" height="1" fill="#14100e" /><rect x="5" y="5" width="1" height="1" fill="#f2a9c4" />
      </svg>
    </span>
    <span class="leading-none">
      <span class="font-display block text-[15px] font-extrabold tracking-[0.08em] text-bone">
        {site.name}<span class="text-phos">_</span>
      </span>
      {!compact && (
        <span class="font-mono mt-1 block text-[9px] uppercase tracking-[0.32em] text-sage">
          {site.tagline}
        </span>
      )}
    </span>
  </a>
) : (
  <span class="flex items-center gap-3" aria-label={site.name}>
    <svg viewBox="0 0 8 6" class={faceCls} role="img" aria-label="Аксолотль Shad11t" shape-rendering="crispEdges">
      <rect x="1" y="0" width="1" height="1" fill="#ff8fb3" /><rect x="6" y="0" width="1" height="1" fill="#ff8fb3" />
      <rect x="0" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="2" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="5" y="1" width="1" height="1" fill="#ff8fb3" /><rect x="7" y="1" width="1" height="1" fill="#ff8fb3" />
      <rect x="1" y="2" width="6" height="1" fill="#f2a9c4" />
      <rect x="1" y="3" width="1" height="1" fill="#f2a9c4" /><rect x="2" y="3" width="1" height="1" fill="#14100e" /><rect x="3" y="3" width="2" height="1" fill="#f2a9c4" /><rect x="5" y="3" width="1" height="1" fill="#14100e" /><rect x="6" y="3" width="1" height="1" fill="#f2a9c4" />
      <rect x="1" y="4" width="6" height="1" fill="#f2a9c4" />
      <rect x="2" y="5" width="1" height="1" fill="#f2a9c4" /><rect x="3" y="5" width="2" height="1" fill="#14100e" /><rect x="5" y="5" width="1" height="1" fill="#f2a9c4" />
    </svg>
    <span class="leading-none">
      <span class="font-display block text-[15px] font-extrabold tracking-[0.08em] text-bone">
        {site.name}<span class="text-phos">_</span>
      </span>
      {!compact && (
        <span class="font-mono mt-1 block text-[9px] uppercase tracking-[0.32em] text-sage">
          {site.tagline}
        </span>
      )}
    </span>
  </span>
)}
